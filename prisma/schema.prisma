// Prisma schema for Golestane Hafez flower studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  description  String   @default("")
  category     String   @default("باکس گل")
  occasion     String   @default("بدون مناسبت")
  price        Int // price in IRT (Toman * 10)
  comparePrice Int? // original price — when set, storefront shows the discount
  image        String
  badge        String?
  stock        Int      @default(10)
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // PERCENT | AMOUNT
  value      Int // percent (1-90) or fixed amount in IRT
  minTotal   Int       @default(0) // minimum cart total in IRT
  usageLimit Int? // max number of uses
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  password  String
  role      String    @default("USER") // USER | ADMIN
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  flowerProfiles FlowerProfile[]
}

model Session {
  id        String   @id // random token stored in httpOnly cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  city      String
  detail    String
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // human readable code, e.g. GH-250612-4821
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String
  customerPhone String
  address       String
  note          String?
  total         Int
  discount      Int       @default(0)
  shipping      Int       @default(0)
  couponCode    String?
  status        String    @default("PENDING") // PENDING | CONFIRMED | PREPARING | SHIPPED | DELIVERED | CANCELLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  sku       String
  price     Int
  qty       Int
  image     String
}

/**
 * Uploaded images stored as blobs so they survive regardless of what
 * happens to files in public/uploads (the sandbox may wipe runtime files,
 * but the SQLite database persists reliably across sessions).
 * Canonical serving URL: /api/uploads/{id} — id is a random unique token.
 */
model UploadedImage {
  id        String   @id @default(cuid())
  mime      String // verified image mime, e.g. image/jpeg
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/**
 * «شخصیت‌شناسی گل» — saved taste profiles.
 * One user can keep many profiles (self / mother / spouse / friend ...).
 * taste axes + answers are stored as JSON strings (SQLite has no list type).
 * The analysis engine lives in src/lib/flower-personality.ts and is shared
 * by both tests (SELF & OTHER) — designed so future features (occasion /
 * season / budget-based recommendations, AI bouquet previews) can build
 * on top of these profiles.
 */
model FlowerProfile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String // profile display name, e.g. «سلیقه شخصی من» / «مادر من»
  kind         String // SELF | OTHER
  relationship String   @default("") // OTHER: مادر، همسر، دوست، ...
  gender       String   @default("") // optional recipient gender
  ageRange     String   @default("") // optional recipient age range
  knowledge    String   @default("") // HIGH | MEDIUM | LOW (how well buyer knows recipient)
  pastPurchase String   @default("") // SATISFIED | UNSURE | FIRST_TIME
  answers      String   @default("[]") // JSON [{ q, a, unknown? }]
  personality  String // ROMANTIC_ARTIST | CALM_MINIMALIST | ...
  confidence   Int      @default(70) // 0-100 system confidence
  colors       String   @default("[]") // JSON string[] of preferred palette keys
  flowers      String   @default("[]") // JSON string[] of preferred flower keys
  dislikedFlowers String @default("[]") // JSON string[] (future: flagged by manual edits)
  presentation String   @default("") // BOUQUET | BOX | BASKET | SINGLE | ARTISTIC_MIX
  size         String   @default("") // SMALL | MEDIUM | LARGE | GRAND
  packaging    String   @default("") // SIMPLE | LUXURY_WRAP | DESIGNER_BOX | NATURAL_ART
  styleNote    String   @default("") // dynamic Persian design-style sentence
  edits        String   @default("{}") // JSON of manual corrections { colors?, flowers?, ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
